<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/padding_small"
    app:cardCornerRadius="@dimen/corner_radius_large"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Image -->
        <ImageView
            android:id="@+id/imageMaison"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/app_name"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bouton Favori -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/favoriteBtn"
            style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_favorite_empty"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/white"
            android:layout_margin="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Nom -->
        <TextView
            android:id="@+id/nomMaison"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_medium"
            android:layout_marginTop="@dimen/padding_medium"
            android:layout_marginEnd="@dimen/padding_medium"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/text_body"
            android:text="Nom Maison"
            app:layout_constraintTop_toBottomOf="@id/imageMaison"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Notation -->
        <TextView
            android:id="@+id/notation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_medium"
            android:layout_marginTop="8dp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:text="4.5"
            app:layout_constraintTop_toBottomOf="@id/nomMaison"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Nombre d'avis -->
        <TextView
            android:id="@+id/nombreAvis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/text_light"
            android:textSize="@dimen/text_small"
            android:text="(12 avis)"
            app:layout_constraintTop_toTopOf="@id/notation"
            app:layout_constraintBottom_toBottomOf="@id/notation"
            app:layout_constraintStart_toEndOf="@id/notation" />

        <!-- Prix -->
        <TextView
            android:id="@+id/prixNuit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/padding_medium"
            android:layout_marginBottom="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_medium"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_body"
            android:text="80€ / nuit"
            app:layout_constraintTop_toTopOf="@id/notation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
